@page "/"
@using System.ComponentModel.DataAnnotations

<style>
    .valid.modified { outline: 2px solid #198754; }
    .invalid { outline: 2px solid #dc3545; }
</style>

<h1>SSR client-side validation</h1>

<p>
    With a <code>DataAnnotationsValidator</code> inside a static SSR
    <code>EditForm</code>, the server renders the validation
    metadata and Blazor's JavaScript enforces it in the browser — instant
    feedback with no round-trip. The .NET model stays the single source of
    truth. It also adds <code>valid</code> / <code>invalid</code> /
    <code>modified</code> CSS classes on the inputs.
</p>

<p>
    Type an invalid email or a short password: the fields get the
    <code>invalid</code> class and messages appear before any request is sent.
    Watch the Network tab — no POST happens until the form is valid.
</p>

<EditForm Model="model" Enhance FormName="registration" OnValidSubmit="Submit">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label" for="Email">Email</label>
        <InputText @bind-Value="model.Email" id="Email" class="form-control" style="max-width: 300px" />
        <ValidationMessage For="() => model.Email" class="text-danger" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="Password">Password (min 8 chars)</label>
        <InputText type="password" @bind-Value="model.Password" id="Password" class="form-control" style="max-width: 300px" />
        <ValidationMessage For="() => model.Password" class="text-danger" />
    </div>

    <button type="submit" class="btn btn-primary">Register</button>
</EditForm>

@if (Submitted)
{
    <div class="alert alert-success mt-3">
        Registered @model.Email validated with
        <code>EditContext.ValidateAsync()</code>
    </div>
}

@code {
    [SupplyParameterFromForm]
    private RegisterModel model { get; set; }
    private bool Submitted;

    protected override void OnInitialized() => model ??= new();

    private async Task Submit(EditContext editContext)
    {
        if (await editContext.ValidateAsync())
        {
            Submitted = true;
        }
    }

    public class RegisterModel
    {
        [Required, EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required, StringLength(100, MinimumLength = 8)]
        public string Password { get; set; } = string.Empty;
    }
}
